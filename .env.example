# OpenAI Compatible API Configuration
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=your-api-key-here
MODEL_NAME=gpt-3.5-turbo

# Local Filesystem MCP Configuration
# 파일 시스템 MCP 활성화 (파일/디렉토리 읽기/쓰기/수정 기능)
FILESYSTEM_MCP_ENABLED=true

# 안전 모드 (삭제 작업 비활성화)
FILESYSTEM_SAFE_MODE=true

# 허용된 경로 (쉼표로 구분, 비워두면 모든 경로 허용)
# Windows 예시: C:\Users\username\Documents,C:\Projects
# Linux/macOS 예시: /home/username/documents,/home/username/projects
FILESYSTEM_ALLOWED_PATHS=

# External MCP Server Configuration (선택사항, 위의 로컬 MCP와 별개)
MCP_SERVER_ENABLED=false
MCP_SERVER_URL=http://localhost:3000

# Chainlit Configuration
CHAINLIT_AUTH_SECRET=change-this-to-a-random-secret-value
